# Variables de entorno — Frontend OncoScan (Next.js)
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA cometas .env.local al repositorio.

# URL pública de tu proyecto Supabase
# Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (publishable) de Supabase — segura para exponerla en el cliente
# Supabase Dashboard > Settings > API > Project API Keys > anon / public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL del backend FastAPI accesible desde el NAVEGADOR (puede ser localhost en dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL del backend FastAPI accesible desde el SERVIDOR Next.js (SSR / Server Actions)
API_URL=http://localhost:8000
