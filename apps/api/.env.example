# Variables de entorno del backend FastAPI (OncaScan API).
# Copiar este archivo a .env y rellenar los valores reales.

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET_NAME=dicom-files

# --- AI inference (OncoScan Dedicated Service on Oracle Cloud Always Free) ---
# URL base que expone /predict y /health.
HF_API_BASE_URL=https://oncoscan-ai.duckdns.org
# Timeout (segundos) para la peticion al modelo.
HF_PREDICT_TIMEOUT=120
# Etiqueta de version que se guarda con cada prediccion (model_version).
HF_MODEL_VERSION=oncoscan-ai@multimodal-v1.2
# Que se envia a /predict: png = PNG normalizado igual que main (contrato de
# Oracle v1.2); source = archivo original para el worker local v2.
# Ausente o invalido = png.
AI_INPUT_MODE=png

# --- Series ZIP y volumenes NIfTI ---
# Solo habilitar donde la maquina tenga RAM para volumenes (al procesarse ocupan
# varias veces su tamano). En Render Free debe quedar en false.
# Ausente = false: .zip, .nii y .nii.gz se rechazan con 400.
VOLUME_UPLOADS_ENABLED=false
